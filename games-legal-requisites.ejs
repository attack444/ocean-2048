<%- include('../partials/head', { title: title, user: user, site: 'games', description: (typeof description !== 'undefined' ? description : undefined) }) %>
<section class="game-hero" style="text-align:left;padding-bottom:6px">
  <h1>Реквизиты</h1>
  <p class="lead" style="margin:12px 0 20px">Самозанятый · Налог на профессиональный доход (НПД)</p>
</section>

<div class="card legal-doc">
  <p class="muted"><strong>Дата публикации:</strong> <%= new Date().toLocaleDateString('ru-RU') %></p>

  <h3>Продавец</h3>
  <table>
    <tr><th>Ф.И.О.</th><td><%= legal.fullName %></td></tr>
    <tr><th>Статус</th><td><%= legal.status %></td></tr>
    <tr><th>ИНН</th><td><%= legal.inn %></td></tr>
    <tr><th>Адрес</th><td><%= legal.address %></td></tr>
    <tr><th>Email</th><td><a href="mailto:<%= legal.email %>"><%= legal.email %></a></td></tr>
  </table>

  <h3>Банковские реквизиты для выплат</h3>
  <table>
    <tr><th>Банк получателя</th><td><%= legal.bankName || '—' %></td></tr>
    <tr><th>БИК</th><td><%= legal.bankBik || '—' %></td></tr>
    <tr><th>Корр. счёт банка</th><td><%= legal.bankCorr || '—' %></td></tr>
    <tr><th>Счёт получателя</th><td><%= legal.bankAccount || '—' %></td></tr>
  </table>

  <h3>Контакты</h3>
  <p>По вопросам оплаты и сотрудничества — <a href="mailto:<%= legal.email %>"><%= legal.email %></a>.</p>
</div>

<style>
  .legal-doc table { border-collapse: collapse; width:100%; margin-top:8px; }
  .legal-doc th, .legal-doc td { border:1px solid var(--line, #2a332b); padding:9px 12px; text-align:left; vertical-align:top; }
  .legal-doc th { color:var(--muted); font-weight:700; width:220px; background:color-mix(in srgb, var(--accent, #76b900) 8%, transparent); }
  .legal-doc h3 { margin:22px 0 6px; color:var(--accent2, #b6f000); }
  .legal-doc p { margin:6px 0; }
  @media (max-width: 600px) { .legal-doc th { width:auto; display:block; } .legal-doc td { display:block; } }
</style>

<script src="/static/games/js/anim.js?v=7"></script>
<%- include('../partials/foot') %>
