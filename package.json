{
  "name": "ocean-2048",
  "version": "1.0.0",
  "description": "Океан 2048 — веб, iOS и Android",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test js/*.test.js scripts/*.test.js",
    "lint": "eslint js scripts",
    "build:www": "node scripts/build-www.js",
    "build:yandex": "node scripts/build-yandex.js",
    "build:vk": "node scripts/build-vk.js",
    "make:shots": "node scripts/make-store-shots.mjs",
    "make:trailer": "node scripts/make-trailer.mjs",
    "make:banners": "node scripts/make-banners.mjs",
    "make:reels": "node scripts/make-reels.mjs",
    "make:promo": "node scripts/make-promo.mjs",
    "make:cover": "node scripts/make-yandex-cover.mjs",
    "make:icons": "node scripts/gen-icons.mjs",
    "make:vk": "node scripts/make-vk-assets.mjs",
    "make:community": "node scripts/make-community-assets.mjs",
    "vk:community": "node scripts/vk-community.mjs",
    "vk:bot": "node scripts/vk-bot.mjs",
    "sync": "npm run build:www && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "android:add": "npm run build:www && npx cap add android",
    "ios:add": "npm run build:www && npx cap add ios",
    "serve": "npx --yes serve . -p 4173"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.4.2",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@eslint/js": "^10.0.1",
    "@vkontakte/vk-bridge": "^3.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "playwright": "^1.62.1"
  }
}
